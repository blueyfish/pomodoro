<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme">
        <!-- Action Bar -->
        <item name="android:windowActionBar" tools:targetApi="honeycomb">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Background -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper" tools:targetApi="eclair">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">true</item>

        <!-- Background Blur -->
        <item name="android:windowBlurBehindEnabled" tools:targetApi="s">true</item>
        <item name="android:windowBlurBehindRadius" tools:targetApi="s">48dp</item>
    </style>
</resources>